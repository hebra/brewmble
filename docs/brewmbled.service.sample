[Unit]
Description=Brewmble Daemon
After=network-online.target
Wants=network-online.target
Documentation=https://codeberg.org/heb/brewmble

[Service]
Type=simple
# Use the default configuration file in the brewmbled home folder
ExecStart=/opt/brewmble/.cargo/bin/brewmbled
# Or, point to a specific configuration file
#ExecStart=/opt/brewmble/.cargo/bin/brewmbled --config /etc/brewmble/brewmbled.yaml
Restart=on-failure
User=brewmble

# Logging filter for the daemon (e.g., info, debug).
# Default is brewmbled=info,tower_http=debug,axum::rejection=trace.
# Environment=RUST_LOG=brewmbled=info

# NOTE: If reboot is enabled, the user below must have a matching sudoers rule:
#   brewmble ALL=(root) NOPASSWD: /usr/bin/systemctl reboot, /usr/sbin/reboot
# NoNewPrivileges must remain false so sudo can elevate.
NoNewPrivileges=false
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
